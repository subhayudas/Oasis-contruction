# ---------------------------------------------------------------------------
# Oasis Construction — environment
#
# Copy to .env.local for development, or set the same variables in the hosting
# provider's dashboard for production. Never commit real values.
#
# Everything here is optional. With none of it set the site builds, renders and
# is fully browsable; the quote form is the one thing that needs configuration
# before launch, and until it has some it tells the visitor to phone instead of
# reporting a message as sent that nobody received.
# ---------------------------------------------------------------------------


# === 1. Form delivery — REQUIRED BEFORE LAUNCH =============================
#
# The three forms all post to /api/contact. Until one of the two providers
# below is configured the endpoint returns 503 and the visitor is shown the
# phone and email fallback.

# Option A — Resend (recommended). Create a key at https://resend.com/api-keys
# and verify the sending domain before going live.
RESEND_API_KEY=
# Where quote requests are delivered. Comma-separated for several recipients.
CONTACT_TO_EMAIL=contact@oasis-construction.ca
# Must be an address on a domain verified with Resend.
CONTACT_FROM_EMAIL=soumissions@oasis-construction.ca

# Option B — any HTTPS endpoint that accepts a JSON POST (Make, Zapier, n8n, a
# CRM webhook…). Used only when the Resend variables above are absent.
# Photo attachments are listed by name but not uploaded through this path, so
# prefer Resend if the business wants to see the photos in the email.
CONTACT_WEBHOOK_URL=


# === 2. Measurement ========================================================
#
# Set GTM *or* GA4, not both — with a container id present the site loads GTM
# only and expects GA4 to be configured inside it. With neither set, no
# third-party script is requested at all and the events are still pushed to
# window.dataLayer, so they can be verified in the console before go-live.
#
# Events emitted: form_submit, form_start, phone_click, photo_upload,
# cta_click, scroll_depth, faq_expand, external_link_click, page_view.

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Meta Pixel. Install now, activate when the ads launch.
NEXT_PUBLIC_META_PIXEL_ID=

# Consent: the banner pushes a Consent Mode v2 `consent_update` to the
# dataLayer and defaults to denied. Configure the GTM container for consent
# mode so tags honour it — Law 25 requires the choice to be real.


# === 3. Spam protection (optional) =========================================
#
# The forms already carry a honeypot field, a minimum fill time and a per-IP
# rate limit. reCAPTCHA v3 is the extra layer for a determined attack.
# Both variables must be set for it to activate; either one alone is ignored,
# so a half-finished setup can never silently reject real leads.
# Keys: https://www.google.com/recaptcha/admin (choose v3)

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
