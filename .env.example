# ---------------------------------------------------------------------------
# Contact form delivery
#
# The quote form posts to /api/contact. Until one of the two providers below is
# configured, the endpoint returns 503 and the visitor is shown the phone and
# email fallback — it never reports a message as sent when nothing was sent.
#
# Copy this file to .env.local (development) or set the same variables in your
# hosting provider's dashboard (production). Never commit real values.
# ---------------------------------------------------------------------------

# Option A — Resend (recommended). Create a key at https://resend.com/api-keys
# and verify the sending domain before going live.
RESEND_API_KEY=
# Where quote requests are delivered. Comma-separated for several recipients.
CONTACT_TO_EMAIL=contact@oasis-construction.ca
# Must be an address on a domain verified with Resend.
CONTACT_FROM_EMAIL=soumissions@oasis-construction.ca

# Option B — any HTTPS endpoint that accepts a JSON POST (Make, Zapier, n8n, a
# CRM webhook…). Used only when the Resend variables above are absent.
# Photo attachments are listed by name but not uploaded through this path.
CONTACT_WEBHOOK_URL=
